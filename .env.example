# Copy to .env and adjust. Every value has a safe default for local use.

NODE_ENV=development
PORT=4100
HOST=0.0.0.0

# Public base URL — used in emails and secure customer/approver links
APP_URL=http://localhost:4100

# 32+ characters. Required in production: encrypts secrets and signs OTP/session tokens.
APP_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# Storage (SQLite database + generated documents)
# STORAGE_DIR=./storage
# DATABASE_FILE=./storage/hcrms.db

# Seed demo data on first boot (reference data always loads)
SEED_ON_BOOT=true

# Rate limiting
OTP_REQUESTS_PER_HOUR=20
API_REQUESTS_PER_MINUTE=600
